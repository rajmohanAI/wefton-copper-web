rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Users ─────────────────────────────────────────────────
    // Authenticated owner read/write only (Requirement 37.1)
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── Products ──────────────────────────────────────────────
    // Public read, admin-only write (Requirements 37.4, 37.5)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Orders ────────────────────────────────────────────────
    // Authenticated create with userId == auth.uid, owner read, admin read/update all (Requirements 37.2, 37.3, 37.4)
    match /orders/{orderId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // ── Reviews ───────────────────────────────────────────────
    // Public read, authenticated create with userId == auth.uid (Requirements 37.5, 37.6)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
    }

    // ── Coupons ───────────────────────────────────────────────
    // Public read, admin-only write (Requirement 37.5)
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Newsletter Subscribers ────────────────────────────────
    // Authenticated create, admin read (Requirement 37.1–37.6)
    match /newsletter_subscribers/{docId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
    }

    // ── Categories ────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
