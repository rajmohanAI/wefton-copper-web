rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Users ─────────────────────────────────────────────────
    // Authenticated owner read/write only (Requirement 37.1)
    match /users/{uid} {
      allow read: if isOwner(uid);
      // New profiles always start as a regular user, and a user can never
      // change their own role (otherwise anyone could make themselves admin).
      allow create: if isOwner(uid) && request.resource.data.role == 'user';
      allow update: if isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    // ── Products ──────────────────────────────────────────────
    // Public read, admin-only write (Requirements 37.4, 37.5)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
      // addReview() updates the rating summary in the same transaction that
      // creates the review, so signed-in users may bump only these two fields.
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ratings', 'reviewsCount']) &&
        request.resource.data.reviewsCount == resource.data.get('reviewsCount', 0) + 1 &&
        request.resource.data.ratings is number &&
        request.resource.data.ratings >= 0 &&
        request.resource.data.ratings <= 5;
    }

    // ── Orders ────────────────────────────────────────────────
    // Authenticated create with userId == auth.uid, owner read, admin read/update all (Requirements 37.2, 37.3, 37.4)
    match /orders/{orderId} {
      // New orders start unpaid; only the server (Admin SDK) records a
      // verified online payment or the Razorpay order/payment ids.
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.paymentStatus == 'pending' &&
        !request.resource.data.keys().hasAny(['razorpayOrderId', 'razorpayAmount', 'razorpayPaymentId']);
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      // Owner attaches the payment screenshot after placing the order.
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['paymentStatus', 'paymentScreenshot', 'paymentReference']) &&
        request.resource.data.paymentStatus == 'uploaded';
    }

    // ── Reviews ───────────────────────────────────────────────
    // Public read, authenticated create with userId == auth.uid (Requirements 37.5, 37.6)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      // "Helpful" button: anyone may add exactly one to the counter.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['helpful']) &&
        request.resource.data.helpful == resource.data.get('helpful', 0) + 1;
    }

    // ── Coupons ───────────────────────────────────────────────
    // Public read, admin-only write (Requirement 37.5)
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Newsletter Subscribers ────────────────────────────────
    // Anyone may subscribe (the footer form works signed out). The doc id is
    // the lowercased email, so a repeat signup is an update and is denied;
    // subscribers can't be listed or read except by admins.
    match /newsletter_subscribers/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'subscribedAt']) &&
        request.resource.data.email == email &&
        email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.subscribedAt == request.time;
      allow read: if isAdmin();
    }

    // ── Categories ────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Search config (trending terms) ────────────────────────
    match /search_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
